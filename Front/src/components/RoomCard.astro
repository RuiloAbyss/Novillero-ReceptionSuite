---
import { string } from "astro:schema";
const {
    title = "",
    description = "",
    img = "",
    amenities = "",
    slug = "",
}: {
    title?: string;
    description?: string;
    img?: string;
    amenities?: string;
    slug?: string;
} = Astro.props


---
<a 
  href={`/room/${slug}`} 
  class="no-underline flex-col text-cafe hover:text-cafe-oscuro block group"
>
  <article class="rounded-xl gap-4 items-center">
    <img 
      src={`/rooms/${img}`} 
      alt={title} 
      class="w-48 h-32 rounded-lg object-cover"
    />
    <div class="flex flex-col">
      <h4 class="text-lg font-semibold text-cafe">{title}</h4>
      <p class="text-cafe">{description}</p>
      {amenities?.length > 0 && (
        <ul class="text-cafe hidden group-hover:flex flex-col gap-1 list-disc list-inside">
          {amenities.map(a => <li>{a}</li>)}
        </ul>
      )}
    </div>
  </article>
</a>

