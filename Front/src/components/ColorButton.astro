---
const {
  label = "Click aquí",
  onClick = null,
  className = "",
  type = "button",
} = Astro.props;

// Estilo base del botón
const baseClasses =
  "px-15 py-3 rounded-full font-bold transition-colors"
---

<button
  type={type}
  class={`${baseClasses} ${className}`}
  onclick={onClick}
>
  {label}
</button>

